# KillaAssistant — environment variables
# Local dev: copy to frontend/.env.local. Production: set these in Vercel.

# Public origin of the deployment. On Vercel this is derived automatically
# from VERCEL_PROJECT_PRODUCTION_URL; set it explicitly for a custom domain.
# Local dev defaults to http://localhost:3000.
# APP_URL=https://killa-assistant.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# NVIDIA NIM (LLM) — optional global fallback; users provide their own keys
# NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Groq (Whisper transcription) — optional global fallback; users provide their own keys
# GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-min-32-chars-random
# Defaults to ${APP_URL}/api/webhooks/telegram
# TELEGRAM_WEBHOOK_URL=

# Google Cloud OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Defaults to ${APP_URL}/api/auth/callback/google — must match the
# "Authorized redirect URI" in Google Cloud Console.
# GOOGLE_REDIRECT_URI=
# Defaults to ${APP_URL}/connections
# OAUTH_SUCCESS_REDIRECT_URL=

# Encryption (AES-256-GCM, 64 hex chars = 32 bytes).
# Keep the SAME key across deployments: it decrypts every stored API key
# and Google token.
ENCRYPTION_KEY=your_64_char_hex_key_here

# Operator-only token for /api/telegram/setup-webhook etc. (x-admin-token header)
ADMIN_TOKEN=change-me-to-a-long-random-64-char-hex-string
